{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "mfkr0001.real-mouse-click",
  "name": "Real Mouse Click",
  "version": "1.1.0",
  "developer": "mfkr0001",
  "description": "Adds a pause-menu shortcut to persistent settings for the Android touch click sound.",
  "resources": {
    "files": [
      "resources/audio/click.wav"
    ]
  },
  "settings": {
    "enabled": {
      "name": "Enable click sound",
      "description": "Turn the touch click sound on or off.",
      "type": "bool",
      "default": true
    },
    "volume": {
      "name": "Click volume",
      "description": "Sound volume from 0% to 100%.",
      "type": "float",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    }
  },
  "tags": [
    "gameplay",
    "interface",
    "utility"
  ]
}
