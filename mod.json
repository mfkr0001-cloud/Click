{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "mfkr0001.real-mouse-click",
  "name": "Real Mouse Click",
  "version": "1.1.8",
  "developer": "mfkr0001",
  "description": "Plays click.wav for every screen touch while a level is active.",
  "resources": {
    "files": [
      "resources/audio/click.wav"
    ]
  },
  "settings": {
    "enabled": {
      "name": "Enable click sound",
      "description": "Turn the gameplay click sound on or off.",
      "type": "bool",
      "default": true
    },
    "volume": {
      "name": "Click volume",
      "description": "Click sound volume from 0 (off) to 5 (maximum).",
      "type": "float",
      "default": 3.0,
      "min": 0.0,
      "max": 5.0,
      "control": {
        "slider": true,
        "slider-step": 0.1
      }
    }
  },
  "tags": [
    "gameplay",
    "interface",
    "utility"
  ]
}
