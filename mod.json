{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "mfkr0001.real-mouse-click",
  "name": "Real Mouse Click",
  "version": "1.0.10-test10",
  "developer": "mfkr0001",
  "description": "Final pre-remaster Android test: per-touch click playback, strict PCM WAV validation and configurable volume.",
  "resources": {
    "files": [
      "resources/audio/click.wav"
    ]
  },
  "settings": {
    "enabled": {
      "name": "Enable click sound",
      "description": "Turn the touch click sound on or off.",
      "type": "bool",
      "default": true
    },
    "volume": {
      "name": "Click volume",
      "description": "Sound volume from 0% to 100%.",
      "type": "float",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    }
  }
}
